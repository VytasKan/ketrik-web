				"shell": {
					"title": {
						"text": [
							{
								"text": "Ketrik Shell"
							}
						]
					},
					"subtitle": {
						"text": [
							{
								"text": "In computing, a shell is just the interface people use to control a system — the outer layer that shows what's going on and lets you act. Ketrik is that shell for your business: the live control panel sitting on top of your data and workflows."
							}
						]
					}
				},
				"shellfaq": [
					{
						"id": "panel1",
						"question": "Is Ketrik a dashboard tool, a workflow tool, or an AI tool?",
						"answer": "It’s the shell — the live interface that sits on top of all three. You or your data experts define how data and workflows work; Ketrik turns that into dashboards, alerts, and a command center you can actually use every day.",
						"category": "shell",
						"iconName": "WidgetsOutlined",
						"badge": "Architecture"
					},
					{
						"id": "panel2",
						"question": "Do I need to be technical to use it?",
						"answer": "No. You see clear numbers, alerts, and actions. The technical work—models, pipelines, custom metrics — can be done by us, your consultant, or your data scientist and then plugged into Ketrik.",
						"category": "shell",
						"iconName": "PersonOutlineOutlined",
						"badge": "Usability"
					}
				],
				"agent": {
					"title": {
						"text": [
							{
								"text": "Ketrik AI Agents"
							}
						]
					},
					"subtitle": {
						"text": [
							{
								"text": "The autonomous engine inside your shell. While you monitor the big picture, Ketrik AI Agents work behind the scenes—routing data, updating systems, and executing routine operations across your business automatically."
							}
						]
					}
				},
				"agentfaq": [
					{
						"id": "panel3",
						"question": "Are Ketrik agents fully autonomous?",
						"answer": "They can act on their own, but within the guardrails you set. You choose which workflows agents can trigger, when they must ask for approval, and what they’re allowed to change.",
						"category": "agent",
						"iconName": "SecurityOutlined",
						"badge": "Control"
					},
					{
						"id": "panel4",
						"question": "What do Ketrik agents actually do day to day?",
						"answer": "Agents watch your metrics and events, spot issues, and kick off the workflows you’ve defined — updating systems, sending alerts, and surfacing decisions in the Ketrik shell so you can see what’s happening.",
						"category": "agent",
						"iconName": "BoltOutlined",
						"badge": "Automation"
					},
					{
						"id": "panel5",
						"question": "Can I start without agents and add them later?",
						"answer": "Yes. Many teams start with the Ketrik shell as a live command center, then introduce agents gradually for specific tasks like risk monitoring, follow‑ups, or routing incidents.",
						"category": "agent",
						"iconName": "ScheduleOutlined",
						"badge": "Adoption"
					}
				],
				"finalCTA": {
					"title": {
						"text": [
							{
								"text": "Ready to See Ketrik in Action?"
							}
						]
					},
					"subtitle": {
						"text": [
							{
								"text": "No sales pitch, no calendar links, and zero waiting. Jump straight into the live interactive shell right now."
