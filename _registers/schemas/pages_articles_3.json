{
	"data": {
		"article": {
			"type": "remote",
			"url": "/_docs/articles/${slug}.md"
		}
	},
	"config": {
		"disableGutter": true,
		"hideFullSizeToggle": true,
		"isFullSize": false,
		"maxWidth": "md",
		"groups": [
			{
				"itemSize": {
					"sm": 12
				},
				"items": [
					{
						"id": "aricle",
						"cardType": "noCard",
						"cardConfig": [
							{
								"type": "cardContent",
								"dataKey": "article",
								"contentConfig": {
									"contentType": "Markdown"
								}
							}
						]
					}
				]
			}
		]
	}
}
